#pragma epistemic_mode = g91

// G91 compatibility starts from the program with the selected possible gate
// relaxed, then reevaluates against a frozen snapshot of the preceding reach
// relation. Every candidate survives here because reach(X,Y) :- linked(X,Y)
// returns the same concrete tuple required by possible reach(X,Y), so every
// vertex pair is linked and queried:
//   linked = {1,2,3} x {1,2,3}

pred vertex(u32).
pred linked(u32, u32).
pred reach(u32, u32).

vertex(1).
vertex(2).
vertex(3).

reach(X, Y) :- linked(X, Y).
reach(X, Z) :- reach(X, Y), linked(Y, Z).
linked(X, Y) :- vertex(X), vertex(Y), possible reach(X, Y).

?- linked(X, Y).
